<Window x:Class="BatchPadV1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BatchPad"
        Width="1000"
        Height="680"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- Normal Button -->
        <Style x:Key="NormalButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5D8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F0F1F3"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E6E7E9"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Green Run Button -->
        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22A447"/>
            <Setter Property="BorderBrush" Value="#22A447"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#279F47"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#279F47"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#198A39"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#198A39"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="#FCFCFD"
                BorderBrush="#DADDE1"
                BorderThickness="0,0,0,1">

            <Grid Margin="16,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Title -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="BatchPad"
                               FontFamily="Segoe UI"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#181818"/>

                    <TextBlock Text="Quick Batch Runner"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#7A7A7A"
                               Margin="0,1,0,0"/>

                </StackPanel>


                <!-- Stop -->
                <Button x:Name="StopButton"
                        Grid.Column="2"
                        Content="■  Stop"
                        Width="100"
                        Margin="0,0,10,0"
                        Style="{StaticResource NormalButtonStyle}"
                        IsEnabled="False"
                        Click="StopButton_Click"/>


                <!-- Run -->
                <Button x:Name="RunButton"
                        Grid.Column="3"
                        Content="▶  Run"
                        Width="110"
                        Style="{StaticResource RunButtonStyle}"
                        Click="RunButton_Click"/>

            </Grid>

        </Border>


        <!-- CODE EDITOR -->
        <Border Grid.Row="1"
                Margin="16"
                Background="White"
                BorderBrush="#D9DBDF"
                BorderThickness="1"
                CornerRadius="9">

            <TextBox x:Name="CodeEditor"
                     FontFamily="Consolas"
                     FontSize="15"
                     Foreground="#202124"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="16"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="False"
                     Text="@echo off&#x0a;title BatchPad Test&#x0a;&#x0a;echo Hello from BatchPad!&#x0a;echo.&#x0a;echo Edit this code and press Run.&#x0a;echo.&#x0a;pause"/>

        </Border>

    </Grid>

</Window>